rules_version = '2';

// FriendBook Storage rules
// Deploy: Firebase Console → Storage → Rules → paste → Publish

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    match /{folder}/{uid}/{file=**} {
      allow read: if true;                      // media is public by URL (like social apps)
      allow write: if signedIn()
                   && request.resource.size < 100 * 1024 * 1024   // 100MB max (reels/videos)
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    match /profiles/{uid}/{file=**} {
      allow read: if true;
      allow write: if signedIn() && request.resource.size < 20 * 1024 * 1024;
    }

    match /chat/{chatId}/{file=**} {
      allow read: if true;
      allow write: if signedIn() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}

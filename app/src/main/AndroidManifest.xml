<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name="com.friendbook.App"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:label="friendbook"
        android:icon="@mipmap/ic_friendbook_crown"
        android:roundIcon="@mipmap/ic_friendbook_crown_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3387480177023669~5696528190"/>

        <activity android:name="com.friendbook.SplashActivity"
            android:icon="@mipmap/ic_friendbook_crown"
            android:roundIcon="@mipmap/ic_friendbook_crown_round"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Custom app deep links: friendbook://invite?ref=USER_ID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="friendbook" />
            </intent-filter>
        </activity>

        <activity android:name="com.friendbook.auth.LoginActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.auth.RegisterActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.LockActivity" android:screenOrientation="portrait" android:excludeFromRecents="true" />
        <activity android:name="com.friendbook.main.MainActivity" android:screenOrientation="portrait" />

        <activity android:name="com.friendbook.post.CreatePostActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.post.PostDetailActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.post.SavedPostsActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.post.FullscreenMediaActivity" android:screenOrientation="portrait"
            android:theme="@style/BlackTheme" />

        <activity android:name="com.friendbook.story.AddStoryActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.story.StoryViewerActivity" android:screenOrientation="portrait"
            android:theme="@style/BlackTheme"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.friendbook.reels.AddReelActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.reels.ReelCommentsActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.reels.ReelPlayerActivity" android:screenOrientation="portrait"
            android:theme="@style/BlackTheme" />

        <activity android:name="com.friendbook.friends.SearchActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.friends.FollowListActivity" android:screenOrientation="portrait" />

        <activity android:name="com.friendbook.chat.ConversationsActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.chat.NewChatActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.chat.CreateGroupChatActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.chat.GroupChatInfoActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.friendbook.chat.ChatActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.friendbook.profile.ProfileActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.profile.EditProfileActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.friendbook.settings.SettingsActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.settings.MarketplaceActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.settings.BlockedUsersActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.settings.ActivityLogActivity" android:screenOrientation="portrait" />

        <activity android:name="com.friendbook.post.WatchActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.post.MemoriesActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.social.EventsActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.social.PokesActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.social.LeaderboardActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.social.PagesActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.settings.FeedPreferencesActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.settings.SessionsActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.settings.TimeSpentActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.settings.ArchiveTrashActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.social.PageDetailActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.friends.BirthdaysActivity" android:screenOrientation="portrait" />

        <activity android:name="com.friendbook.bluetick.BlueTickActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.bluetick.MonetizationActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.live.LiveActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize" />
        <activity android:name="com.friendbook.admin.AdMobSettingsActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.auth.ForgotPasswordActivity" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="com.friendbook.groups.GroupsActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.groups.GroupDetailActivity" android:screenOrientation="portrait" />

        <activity android:name="com.friendbook.admin.AdminPanelActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.admin.ModeratorDeskActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.admin.AdminContentActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.admin.AdminReportsActivity" android:screenOrientation="portrait" />
        <activity android:name="com.friendbook.admin.AdminFeedbackActivity" android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
